/** @file
 * Private structure sizing and mock definitions. This allows these structures
 * to still be allocated statically, without needing to expose implementation
 * details that determine the structure's members and sizes.
 *
 * This header is separate from stumpless/config.h because the sizes cannot be
 * calculated until the configuration headers are already generated, as they
 * affect the structure composition and size.
 *
 * @since release v3.0.0
 */


#ifndef __STUMPLESS_CONFIG_SIZE_H
#define __STUMPLESS_CONFIG_SIZE_H

/**
 * The size (in bytes) needed to hold a buffer target structure.
 *
 * @since release v3.0.0
 */
@STUMPLESS_BUFFER_TARGET_SIZE_CODE@

#ifdef __cplusplus
extern "C" {
#endif

#ifdef __cplusplus
} /* extern "C" */
#endif

#endif /* __STUMPLESS_CONFIG_SIZE_H */
